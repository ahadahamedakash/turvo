model Tenant {
    id                     String         @id @default(uuid()) @db.Uuid
    name                   String
    slug                   String         @unique
    description            String?
    address                String?
    timezone               String
    website                String?
    openingHour            DateTime?      @db.Time(6)
    closingHour            DateTime?      @db.Time(6)
    weekendDays            Json           @default("[5,6]")
    autoGenerateEnabled    Boolean        @default(false)
    autoGenerateDaysAhead  Int            @default(14)
    status                 TenantStatus   @default(Active)
    createdAt              DateTime       @default(now())
    updatedAt              DateTime       @updatedAt
    deletedAt              DateTime?
    auditLogs              AuditLog[]
    bookingEvents          BookingEvent[]
    bookings               Booking[]
    bookingSlots           BookingSlot[]
    courts                 Court[]
    customers              Customer[]
    holidays               Holiday[]
    invitations            Invitation[]
    payments               Payment[]
    pricingRules           PricingRule[]
    slots                  Slot[]
    tenantMembers          TenantMember[]

    @@map("tenants")
}
