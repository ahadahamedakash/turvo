generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  slug            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invitations     Invitation[]
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  module          PermissionModule
  slug            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id             String       @id @default(uuid()) @db.Uuid
  tenantMemberId String       @db.Uuid
  roleId         String       @db.Uuid
  assignedBy     String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  assignedByUser User         @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])
  tenantMember   TenantMember @relation(fields: [tenantMemberId], references: [id])

  @@unique([tenantMemberId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  firstName            String
  lastName             String
  gender               Gender?
  email                String         @unique
  phone                String?
  address              String?
  password             String
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isSuperAdmin         Boolean        @default(false)
  passwordResetExpires DateTime?
  passwordResetToken   String?        @unique
  auditLogs            AuditLog[]
  bookingEvents        BookingEvent[]
  cancelledBookings    Booking[]      @relation("BookingCancelledBy")
  createdBookings      Booking[]      @relation("BookingCreatedBy")
  deletedBookings      Booking[]      @relation("BookingDeletedBy")
  updatedBookings      Booking[]      @relation("BookingUpdatedBy")
  createdCourts        Court[]        @relation("CourtCreatedBy")
  deletedCourts        Court[]        @relation("CourtDeletedBy")
  updatedCourts        Court[]        @relation("CourtUpdatedBy")
  customers            Customer[]
  acceptedInvitations  Invitation[]   @relation("InvitationAcceptedBy")
  payments             Payment[]
  refreshTokens        RefreshToken[]
  tenantMembers        TenantMember[]
  assignedUserRoles    UserRole[]     @relation("UserRoleAssignedBy")

  @@index([phone])
  @@map("users")
}

model RefreshToken {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  token             String        @unique
  isRevoked         Boolean       @default(false)
  expiresAt         DateTime
  replacedByTokenId String?       @unique @db.Uuid
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  replacedByToken   RefreshToken? @relation("TokenReplacement", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken? @relation("TokenReplacement")
  user              User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  description   String?
  address       String?
  timezone      String
  website       String?
  openingHour   DateTime?      @db.Time(6)
  closingHour   DateTime?      @db.Time(6)
  status        TenantStatus   @default(Active)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  auditLogs     AuditLog[]
  bookingEvents BookingEvent[]
  bookings      Booking[]
  courts        Court[]
  customers     Customer[]
  invitations   Invitation[]
  payments      Payment[]
  pricingRules  PricingRule[]
  slots         Slot[]
  tenantMembers TenantMember[]

  @@map("tenants")
}

model TenantMember {
  id                 String       @id @default(uuid()) @db.Uuid
  tenantId           String       @db.Uuid
  userId             String       @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  invitationsSent    Invitation[] @relation("InvitationInvitedBy")
  invitationsRevoked Invitation[] @relation("InvitationRevokedBy")
  payments           Payment[]    @relation("PaymentIssuedBy")
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  user               User         @relation(fields: [userId], references: [id])
  userRoles          UserRole[]

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String?   @db.Uuid
  firstName String
  lastName  String
  email     String
  phone     String?
  gender    Gender?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  bookings  Booking[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])

  @@unique([tenantId, email])
  @@index([phone])
  @@map("customers")
}

model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  email           String
  tenantId        String           @db.Uuid
  roleId          String           @db.Uuid
  token           String           @unique
  status          InvitationStatus @default(Pending)
  expiresAt       DateTime
  revokedAt       DateTime?
  acceptedAt      DateTime?
  acceptedBy      String?          @db.Uuid
  invitedBy       String           @db.Uuid
  revokedBy       String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  acceptedByUser  User?            @relation("InvitationAcceptedBy", fields: [acceptedBy], references: [id])
  invitedByMember TenantMember     @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])
  revokedByMember TenantMember?    @relation("InvitationRevokedBy", fields: [revokedBy], references: [id])
  role            Role             @relation(fields: [roleId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email], map: "invitations_one_pending_per_tenant_email", where: raw("(status = 'Pending'::\"InvitationStatus\")"))
  @@index([tenantId, email, status])
  @@map("invitations")
}

model Court {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  status        CourtStatus   @default(Available)
  tenantId      String        @db.Uuid
  createdBy     String        @db.Uuid
  updatedBy     String?       @db.Uuid
  deletedBy     String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  bookings      Booking[]
  createdByUser User          @relation("CourtCreatedBy", fields: [createdBy], references: [id])
  deletedByUser User?         @relation("CourtDeletedBy", fields: [deletedBy], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  updatedByUser User?         @relation("CourtUpdatedBy", fields: [updatedBy], references: [id])
  pricingRules  PricingRule[]
  slots         Slot[]

  @@unique([tenantId, name])
  @@map("courts")
}

model PricingRule {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  courtId   String    @db.Uuid
  dayType   DayType
  startTime DateTime  @db.Time(6)
  endTime   DateTime  @db.Time(6)
  price     Decimal   @db.Decimal(10, 2)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  court     Court     @relation(fields: [courtId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  slots     Slot[]

  @@index([courtId, dayType, startTime])
  @@map("pricing_rules")
}

model Slot {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @db.Uuid
  courtId       String       @db.Uuid
  pricingRuleId String?      @db.Uuid
  price         Decimal      @db.Decimal(10, 2)
  date          DateTime     @db.Date
  startTime     DateTime     @db.Time(6)
  endTime       DateTime     @db.Time(6)
  status        SlotStatus   @default(Available)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  heldAt        DateTime?
  heldBy        String?      @db.Uuid
  heldUntil     DateTime?
  bookings      Booking[]
  court         Court        @relation(fields: [courtId], references: [id])
  pricingRule   PricingRule? @relation(fields: [pricingRuleId], references: [id])
  tenant        Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([courtId, date, startTime], name: "no_duplicate_slot_generation")
  @@index([tenantId, status, date])
  @@map("slots")
}

model Booking {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  courtId         String         @db.Uuid
  slotId          String         @db.Uuid
  customerId      String         @db.Uuid
  status          BookingStatus  @default(Pending)
  subTotal        Decimal        @db.Decimal(10, 2)
  discount        Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  notes           String?
  createdBy       String         @db.Uuid
  updatedBy       String?        @db.Uuid
  deletedBy       String?        @db.Uuid
  cancelledBy     String?        @db.Uuid
  cancelledAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  bookingEvents   BookingEvent[]
  cancelledByUser User?          @relation("BookingCancelledBy", fields: [cancelledBy], references: [id])
  court           Court          @relation(fields: [courtId], references: [id])
  createdByUser   User           @relation("BookingCreatedBy", fields: [createdBy], references: [id])
  customer        Customer       @relation(fields: [customerId], references: [id])
  deletedByUser   User?          @relation("BookingDeletedBy", fields: [deletedBy], references: [id])
  slot            Slot           @relation(fields: [slotId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  updatedByUser   User?          @relation("BookingUpdatedBy", fields: [updatedBy], references: [id])
  payments        Payment[]

  @@index([slotId])
  @@index([tenantId, customerId, createdAt])
  @@map("bookings")
}

model BookingEvent {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  bookingId    String           @db.Uuid
  eventType    BookingEventType
  oldValue     Json?
  newValue     Json?
  issuedBy     String           @db.Uuid
  createdAt    DateTime         @default(now())
  booking      Booking          @relation(fields: [bookingId], references: [id])
  issuedByUser User             @relation(fields: [issuedBy], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

model Payment {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  bookingId       String          @db.Uuid
  amount          Decimal         @db.Decimal(10, 2)
  method          PaymentMethod
  gateway         PaymentGateway?
  currency        String          @default("BDT")
  status          PaymentStatus   @default(Pending)
  transactionId   String?
  referenceNumber String?
  paidBy          String?         @db.Uuid
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  issuedBy        String          @db.Uuid
  type            PaymentType
  booking         Booking         @relation(fields: [bookingId], references: [id])
  issuedByMember  TenantMember    @relation("PaymentIssuedBy", fields: [issuedBy], references: [id])
  paidByUser      User?           @relation(fields: [paidBy], references: [id])
  tenant          Tenant          @relation(fields: [tenantId], references: [id])

  @@index([bookingId, status])
  @@index([bookingId, type])
  @@map("payments")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  userId     String      @db.Uuid
  entityType String
  entityId   String
  action     AuditAction
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId, tenantId, createdAt])
  @@map("audit_logs")
}

enum Gender {
  Male
  Female
  Other
}

enum TenantStatus {
  Active
  Inactive
  Suspended
}

enum CourtStatus {
  Available
  Maintenance
  Inactive
}

enum DayType {
  Weekday
  Weekend
  Holiday
}

enum SlotStatus {
  Available
  Booked
  Blocked
  Expired
  Held
}

enum BookingStatus {
  Pending
  Confirmed
  Completed
  Cancelled
  NoShow
}

enum BookingEventType {
  Created
  Updated
  StatusChanged
  Rescheduled
  Cancelled
  PaymentReceived
}

enum PaymentType {
  Advance
  Due
  Refund
}

enum PaymentMethod {
  Cash
  Card
  MobileBanking
}

enum PaymentGateway {
  SSLCommerz
  Bkash
  Nagad
  Stripe
  Manual
}

enum PaymentStatus {
  Pending
  Paid
  Failed
  Refunded
}

enum InvitationStatus {
  Pending
  Accepted
  Revoked
  Expired
}

enum AuditAction {
  Create
  Update
  Delete
  Restore
}

enum PermissionModule {
  Booking
  Customer
  Court
  Payment
  Reports
  Users
}
